{
  "name": "email-gateway",
  "workspaces": [
    "client"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "start": "secrets-run run --env-file=.env.tpl -- bun run src/index.ts",
    "dev": "secrets-run run --env-file=.env.tpl -- bun run --watch src/index.ts",
    "email": "email dev --dir src/emails",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "import-legacy": "bun run scripts/import-legacy.ts",
    "typecheck": "tsc --noEmit && bun run client:typecheck",
    "client:typecheck": "cd client && bun run typecheck",
    "lint": "oxlint --type-aware && cd client && basalt-ui check-theme",
    "test": "bun test",
    "build": "cd client && bun run build",
    "client:dev": "cd client && bun run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@ai-sdk/typesafe-ai": "3.0.17",
    "@aws-sdk/client-sesv2": "3.1161.0",
    "@elysia/static": "1.4.12",
    "@elysiajs/bearer": "1.4.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@react-email/render": "2.2.0",
    "ai": "7.0.137",
    "basalt-ui": "2.29.0",
    "elysia": "1.4.31",
    "imapflow": "2.10.0",
    "postal-mime": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.26",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
